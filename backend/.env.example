# Copy this file to .env and fill in real values. Do not commit .env.
DATABASE_URL="file:./praxis.db"

# Use a long, random secret in production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=24h

# SMTP credentials for verification / reset emails (optional in development).
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@praxis.edu

PORT=5000
FRONTEND_URL=http://localhost:5173
